NEXT_PUBLIC_ENABLE_AI_INTERVIEW=true
NEXT_PUBLIC_ENABLE_HPC_LAB=false
AI_INTERVIEW_OLLAMA_URL=http://127.0.0.1:11434
AI_INTERVIEW_STT_URL=http://127.0.0.1:9000
AI_INTERVIEW_TTS_URL=http://127.0.0.1:8000

# --- SC26 outreach module ---
# Off by default -- turn on once the Azure app + mailbox are set up (see SETUP.md).
NEXT_PUBLIC_ENABLE_SC26_OUTREACH=false

# Azure AD app registration (app-only Graph auth). See SETUP.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The single mailbox this module sends from and watches for replies,
# e.g. sc26@ddn.com or a rep's own DDN mailbox.
SC26_MAILBOX=
SC26_SENDER_NAME=

# Public base URL this app is reachable at once deployed (used to build the
# tracking pixel/click URLs and the Graph webhook notification URL).
# Must be a real public HTTPS URL for tracking/replies to work -- localhost
# will not receive pixel requests, link clicks, or Graph notifications.
APP_BASE_URL=http://localhost:3000

# Where the tracked booking link ultimately redirects to.
SC26_BOOKING_URL=https://www.ddn.com/lp/events/sc2026/book-a-meeting/

# Random long secrets -- generate with `openssl rand -hex 32`.
TRACKING_TOKEN_SECRET=
GRAPH_WEBHOOK_CLIENT_STATE=
CRON_SECRET=
