NEXT_PUBLIC_ENABLE_AI_INTERVIEW=true
NEXT_PUBLIC_ENABLE_HPC_LAB=false
AI_INTERVIEW_OLLAMA_URL=http://127.0.0.1:11434
AI_INTERVIEW_STT_URL=http://127.0.0.1:9000
AI_INTERVIEW_TTS_URL=http://127.0.0.1:8000

# --- Outreach module (multi-campaign) ---
# Off by default. Var name predates this covering more than the original
# SC26 campaign -- kept as-is so enabling it doesn't need a second Render
# env var on top of this one. See ui/partner-hub/docs/OUTREACH_SETUP.md.
NEXT_PUBLIC_ENABLE_SC26_OUTREACH=false

# The single mailbox this module sends from and watches for replies --
# shared by every campaign, e.g. a rep's own DDN mailbox.
SC26_MAILBOX=
SC26_SENDER_NAME=

# Public base URL this app is reachable at once deployed (used to build the
# tracking pixel/click URLs). Must be a real public HTTPS URL for
# tracking/replies to work -- localhost will not receive pixel requests or
# link clicks.
APP_BASE_URL=http://localhost:3000

# Where the tracked booking link ultimately redirects to.
SC26_BOOKING_URL=https://www.ddn.com/lp/events/sc2026/book-a-meeting/

# Random long secrets -- generate with `openssl rand -hex 32`.
TRACKING_TOKEN_SECRET=
CRON_SECRET=

# --- Reply detection: Power Automate -> Gmail IMAP relay ---
# Power Automate (self-authorized Outlook connector on the DDN mailbox, no
# admin consent/Graph API) relays replies as plain-text notification emails
# to this Gmail mailbox; this app polls it via IMAP. See OUTREACH_SETUP.md.
# Poll cadence is controlled by whatever calls POST /api/outreach/imap-poll
# (a GitHub Actions schedule, see .github/workflows/outreach-imap-poll.yml)
# -- CRON_SECRET above authorizes that call, there's no separate secret here.
#
# IMPORTANT for a new campaign: the Power Automate flow that relays replies
# out of the real DDN inbox currently triggers on `contains(Subject,
# 'SC26')`. A reply to a campaign whose subject doesn't contain "SC26" will
# NOT be relayed or detected as a reply until that flow's trigger condition
# is broadened (or every campaign's subject is made to include a shared
# marker the trigger can match on instead of the event name). This can't be
# fixed from this repo -- it's configuration inside the Power Automate flow
# itself.
SC26_IMAP_HOST=imap.gmail.com
SC26_IMAP_PORT=993
SC26_IMAP_USER=
SC26_IMAP_APP_PASSWORD=
# Safety cap on how many new relay messages one poll will process, so a
# large unexpected backlog can't turn a single request into a very long one
# -- the rest are picked up on the next poll.
SC26_IMAP_POLL_MAX_MESSAGES=25

# --- Sending: app -> Resend -> Power Automate -> DDN mailbox ---
# The app emails a "send request" via the Resend API (https://resend.com)
# to SC26_MAILBOX below; a Power Automate flow there (separate from the
# reply-detection flow, see OUTREACH_SETUP.md) turns it into the actual
# outreach email and emails a confirmation back to the same Gmail mailbox
# the IMAP poller already watches. This part is not Graph-based either.
#
# Get RESEND_API_KEY from resend.com (free tier, no domain verification
# needed) -- API Keys in the dashboard. Sign up for that account using the
# same address as SC26_MAILBOX: Resend's shared test sender can only mail
# the account's own address until a sending domain is verified, and
# SC26_MAILBOX is always the recipient of this particular email, so that
# sidesteps needing to verify a domain at all.
RESEND_API_KEY=
