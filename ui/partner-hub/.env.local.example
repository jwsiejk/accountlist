NEXT_PUBLIC_ENABLE_AI_INTERVIEW=true
NEXT_PUBLIC_ENABLE_HPC_LAB=false
AI_INTERVIEW_OLLAMA_URL=http://127.0.0.1:11434
AI_INTERVIEW_STT_URL=http://127.0.0.1:9000
AI_INTERVIEW_TTS_URL=http://127.0.0.1:8000

# --- SC26 outreach module ---
# Off by default -- turn on once the Azure app + mailbox are set up (see SETUP.md).
NEXT_PUBLIC_ENABLE_SC26_OUTREACH=false

# Azure AD app registration (app-only Graph auth). See SETUP.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The single mailbox this module sends from and watches for replies,
# e.g. sc26@ddn.com or a rep's own DDN mailbox.
SC26_MAILBOX=
SC26_SENDER_NAME=

# Public base URL this app is reachable at once deployed (used to build the
# tracking pixel/click URLs and the Graph webhook notification URL).
# Must be a real public HTTPS URL for tracking/replies to work -- localhost
# will not receive pixel requests, link clicks, or Graph notifications.
APP_BASE_URL=http://localhost:3000

# Where the tracked booking link ultimately redirects to.
SC26_BOOKING_URL=https://www.ddn.com/lp/events/sc2026/book-a-meeting/

# Random long secrets -- generate with `openssl rand -hex 32`.
TRACKING_TOKEN_SECRET=
GRAPH_WEBHOOK_CLIENT_STATE=
CRON_SECRET=

# --- SC26 reply detection: Power Automate -> Gmail IMAP relay ---
# Power Automate (self-authorized Outlook connector on the DDN mailbox, no
# admin consent) relays SC26-related replies as plain-text notification
# emails to this Gmail mailbox; this app polls it via IMAP rather than
# Graph webhooks. See SETUP.md. Poll cadence is controlled by whatever
# calls POST /api/sc26-outreach/imap-poll (e.g. a Render Cron Job) --
# CRON_SECRET above authorizes that call, there's no separate secret here.
SC26_IMAP_HOST=imap.gmail.com
SC26_IMAP_PORT=993
SC26_IMAP_USER=
SC26_IMAP_APP_PASSWORD=
# Safety cap on how many new relay messages one poll will process, so a
# large unexpected backlog can't turn a single request into a very long one
# -- the rest are picked up on the next poll.
SC26_IMAP_POLL_MAX_MESSAGES=200

# --- SC26 sending: app -> Resend -> Power Automate -> DDN mailbox ---
# Outbound sending also avoids Graph (no Azure AD app registration). The app
# emails a "send request" via the Resend API (https://resend.com) to
# SC26_MAILBOX below; a Power Automate flow there (separate from the
# reply-detection flow, see SETUP.md) turns it into the actual outreach
# email and emails a confirmation back to the same Gmail mailbox the IMAP
# poller already watches.
#
# Get RESEND_API_KEY from resend.com (free tier, no domain verification
# needed) -- API Keys in the dashboard. Sign up for that account using the
# same address as SC26_MAILBOX: Resend's shared test sender can only mail
# the account's own address until a sending domain is verified, and
# SC26_MAILBOX is always the recipient of this particular email, so that
# sidesteps needing to verify a domain at all.
RESEND_API_KEY=
