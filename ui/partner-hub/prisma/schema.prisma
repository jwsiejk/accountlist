// Office Booking MVP schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Office {
  id          Int       @id @default(autoincrement())
  name        String
  address     String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  officeId  Int
  name      String
  email     String
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, start, end])
}

// --- SC26 outreach module ---------------------------------------------

enum ProspectStatus {
  PENDING
  SENDING
  SENT
  OPENED
  CLICKED
  REPLIED
  BOUNCED
}

model Prospect {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  firstName     String
  lastName      String?
  company       String?
  title         String?
  status        ProspectStatus  @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages      OutreachMessage[]

  @@index([status])
}

model OutreachMessage {
  id                Int              @id @default(autoincrement())
  prospectId        Int
  mailbox           String
  subject           String
  trackingToken     String           @unique
  graphMessageId    String?
  graphConversationId String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  prospect          Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  events            TrackingEvent[]

  @@index([prospectId])
  @@index([graphConversationId])
}

enum TrackingEventType {
  OPEN
  CLICK
  REPLY
  BOUNCE
  SEND_CONFIRMED
}

model TrackingEvent {
  id                Int              @id @default(autoincrement())
  outreachMessageId Int
  type              TrackingEventType
  occurredAt        DateTime         @default(now())
  meta              String?

  outreachMessage   OutreachMessage  @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)

  @@index([outreachMessageId, type])
}

// Tracks the Microsoft Graph change-notification subscription per mailbox
// so it can be renewed before it expires (mail subscriptions max out at
// ~3 days). One row per monitored mailbox.
model MailSubscription {
  id                  Int      @id @default(autoincrement())
  mailbox             String   @unique
  graphSubscriptionId String
  expiresAt           DateTime
  updatedAt           DateTime @updatedAt
}

// Tracks how far the IMAP poller has gotten through the Gmail relay
// mailbox (scnotifyjamessiejk@gmail.com), so each poll only fetches UIDs it
// hasn't processed yet instead of re-scanning the whole mailbox. One row
// per watched mailbox. uidValidity is recorded alongside lastUid because
// IMAP UIDs are only meaningful relative to it -- if Gmail ever changes it
// (mailbox recreated), stored UIDs are no longer valid and the poller
// resets to "start from new mail only" rather than reusing a stale cursor.
model ImapPollCursor {
  id          Int      @id @default(autoincrement())
  mailbox     String   @unique
  uidValidity Int
  lastUid     Int      @default(0)
  updatedAt   DateTime @updatedAt
}
