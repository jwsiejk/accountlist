// Office Booking MVP schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Office {
  id          Int       @id @default(autoincrement())
  name        String
  address     String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  officeId  Int
  name      String
  email     String
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, start, end])
}

// --- Outreach module -----------------------------------------------------
//
// One shared send/reply infrastructure (a single Gmail relay mailbox, one
// Power Automate send-flow and reply-relay, one IMAP poller -- see
// docs/OUTREACH_SETUP.md) serves any number of separate outreach
// *campaigns* (SC26 was the first). A Campaign owns its own prospect list
// and its own set of email templates; nothing about sending, tracking, or
// the relay chain is duplicated per campaign.

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  // Suggested gap between sequence emails, used only to show "due"/"overdue"
  // in the dashboard and report -- nothing sends automatically.
  email2DelayDays Int  @default(3) // days after Email 1 is sent
  email3DelayDays Int  @default(4) // days after Email 2 is sent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prospects   Prospect[]
  templates   Template[]
  batches     Batch[]
}

// A named group of prospects within a campaign -- "the people I emailed in
// this round". Campaign -> Batch -> Prospect. A prospect belongs to at most
// one batch; batchId is null for "Unassigned" (e.g. after the batch they
// were in was deleted). Moving a prospect between batches only changes
// batchId, so their messages, tracking events and sequence progress (all
// hung off the Prospect) travel with them untouched.
model Batch {
  id         Int      @id @default(autoincrement())
  campaignId Int
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospects  Prospect[]

  @@unique([campaignId, name])
  @@index([campaignId])
}

// A reusable email template scoped to one campaign. Previously these lived
// as files under lib/outreach/templates/ (edit source, redeploy to change
// copy) -- now they're rows a person creates/edits/deletes from the
// dashboard itself, same as everything else per-campaign.
model Template {
  id         Int      @id @default(autoincrement())
  campaignId Int
  name       String
  subject    String
  html       String
  // Which email in the sequence this template is (1, 2 or 3), or null if
  // it isn't part of the sequence. The dashboard pre-selects the template
  // tagged for the step being sent.
  sequenceStep Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

enum ProspectStatus {
  PENDING
  SENDING
  SENT
  OPENED
  CLICKED
  REPLIED
  BOUNCED
}

model Prospect {
  id            Int             @id @default(autoincrement())
  campaignId    Int
  batchId       Int?
  email         String
  firstName     String
  lastName      String?
  company       String?
  title         String?
  status        ProspectStatus  @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  batch         Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  messages      OutreachMessage[]

  // Unique per campaign, not globally -- the same person can legitimately
  // be a prospect in two different campaigns (e.g. a different event) at
  // once.
  @@unique([campaignId, email])
  @@index([status])
  @@index([campaignId])
  @@index([batchId])
}

model OutreachMessage {
  id                Int              @id @default(autoincrement())
  prospectId        Int
  // Position in the sequence this message was sent as: 1 = Email 1, etc.
  step              Int              @default(1)
  mailbox           String
  subject           String
  trackingToken     String           @unique
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  prospect          Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  events            TrackingEvent[]

  @@index([prospectId])
}

enum TrackingEventType {
  OPEN
  CLICK
  REPLY
  BOUNCE
  SEND_CONFIRMED
}

model TrackingEvent {
  id                Int              @id @default(autoincrement())
  outreachMessageId Int
  type              TrackingEventType
  occurredAt        DateTime         @default(now())
  meta              String?

  outreachMessage   OutreachMessage  @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)

  @@index([outreachMessageId, type])
}

// Tracks how far the IMAP poller has gotten through the Gmail relay
// mailbox (scnotifyjamessiejk@gmail.com), so each poll only fetches UIDs it
// hasn't processed yet instead of re-scanning the whole mailbox. One row
// per watched mailbox. uidValidity is recorded alongside lastUid because
// IMAP UIDs are only meaningful relative to it -- if Gmail ever changes it
// (mailbox recreated), stored UIDs are no longer valid and the poller
// resets to "start from new mail only" rather than reusing a stale cursor.
model ImapPollCursor {
  id          Int      @id @default(autoincrement())
  mailbox     String   @unique
  uidValidity Int
  lastUid     Int      @default(0)
  updatedAt   DateTime @updatedAt
}
