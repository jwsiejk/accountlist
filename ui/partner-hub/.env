# Local-only SQLite database for Office Booking MVP
DATABASE_URL="file:./dev.db"

# Local Ollama server (used by Account Mapping "AI Review")
# If running Next.js inside Docker, you may need: http://host.docker.internal:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Recommended small model for fast review UX
OLLAMA_MODEL="llama3.2:3b"
