+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+:root {
+  --brand-primary: 220 75% 55%;
+  --brand-secondary: 262 83% 58%;
+  --brand-accent: 20 95% 60%;
+  --surface-base: 0 0% 100%;
+  --surface-muted: 210 40% 96%;
+  --surface-elevated: 0 0% 100%;
+  --foreground: 222 47% 11%;
+  --border-color: 214 32% 91%;
+  --background: var(--surface-base);
+}
+
+.dark {
+  --brand-primary: 220 100% 80%;
+  --brand-secondary: 262 73% 75%;
+  --brand-accent: 20 95% 70%;
+  --surface-base: 222 47% 11%;
+  --surface-muted: 222 47% 17%;
+  --surface-elevated: 222 47% 14%;
+  --foreground: 210 40% 98%;
+  --border-color: 215 25% 27%;
+  --background: var(--surface-base);
+}
+
+body {
+  @apply bg-background text-foreground antialiased;
+  background-color: hsl(var(--background));
+  color: hsl(var(--foreground));
+}
+
+a {
+  @apply text-primary underline-offset-4 hover:underline;
+}
+
+:focus-visible {
+  outline: 2px solid hsl(var(--brand-accent));
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
