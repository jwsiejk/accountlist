+              </CardContent>
+              {item.restricted ? (
+                <div className="px-6 pb-4 text-xs font-medium text-foreground/50">
+                  Restricted • Request Pure portal access
+                </div>
+              ) : null}
+            </Card>
+          ))}
+        </div>
+      </section>
+    </div>
+  );
+}
diff --git a/ui/partner-hub/components/app-header.tsx b/ui/partner-hub/components/app-header.tsx
